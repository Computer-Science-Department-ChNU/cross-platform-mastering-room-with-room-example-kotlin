+package ua.edu.chnu.kkn.masteringdb.data.repository
+
+import kotlinx.coroutines.flow.Flow
+import kotlinx.coroutines.flow.map
+import ua.edu.chnu.kkn.masteringdb.data.local.dao.CategoryDao
+import ua.edu.chnu.kkn.masteringdb.data.local.entity.CategoryEntity
+import ua.edu.chnu.kkn.masteringdb.data.local.mapper.toModel
+import ua.edu.chnu.kkn.masteringdb.data.local.relation.CategoryWithTasks
+import ua.edu.chnu.kkn.masteringdb.data.model.Category
+
+class RoomCategoryRepository(
+    private val categoryDao: CategoryDao,
+) : CategoryRepository {
+
+    override fun observeCategories(): Flow<List<Category>> =
+        categoryDao.observeCategoriesWithTasks().map { list -> list.map(CategoryWithTasks::toModel) }
+
+    override suspend fun addCategory(name: String) {
+        categoryDao.insert(CategoryEntity(name = name))
+    }
+
+    // Tasks of the deleted category keep existing: the FK sets their category_id to NULL
+    override suspend fun deleteCategory(id: Long) {
+        categoryDao.deleteById(id)
+    }
+}
