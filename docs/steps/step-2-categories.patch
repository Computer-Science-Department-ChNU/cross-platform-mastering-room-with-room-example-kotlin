@@ -0,0 +1,54 @@
+package ua.edu.chnu.kkn.masteringdb.data.local
+
+import androidx.room3.testing.MigrationTestHelper
+import androidx.sqlite.SQLiteConnection
+import androidx.sqlite.driver.bundled.BundledSQLiteDriver
+import androidx.sqlite.execSQL
+import java.nio.file.Files
+import java.nio.file.Path
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlin.test.assertTrue
+import kotlinx.coroutines.test.runTest
+import org.junit.Rule
+
+/**
+ * Creates a database of an old version from `shared/schemas`, runs the migrations
+ * and lets Room validate the resulting schema against the expected one.
+ * Rows are inserted with raw SQL: DAOs always expect the latest schema.
+ */
+class MigrationTest {
+
+    @get:Rule
+    val helper = MigrationTestHelper(
+        schemaDirectoryPath = Path.of("schemas"),
+        databasePath = Files.createTempDirectory("migration-test").resolve("test.db"),
+        driver = BundledSQLiteDriver(),
+        databaseClass = AppDatabase::class,
+        databaseFactory = { AppDatabaseConstructor.initialize() },
+    )
+
+    @Test
+    fun migrate1To2_keepsTasksWithoutCategory() = runTest {
+        helper.createDatabase(1).apply {
+            execSQL("INSERT INTO tasks (id, title, description, is_done, created_at) VALUES (1, 'Buy milk', '2 l', 0, 100)")
+            close()
+        }
+
+        val connection = helper.runMigrationsAndValidate(2)
+
+        connection.querySingleRow("SELECT title, description, category_id FROM tasks WHERE id = 1") {
+            assertEquals("Buy milk", getText(0))
+            assertEquals("2 l", getText(1))
+            assertTrue(isNull(2))
+        }
+        connection.close()
+    }
+}
+
+internal fun SQLiteConnection.querySingleRow(sql: String, block: androidx.sqlite.SQLiteStatement.() -> Unit) {
+    prepare(sql).use { statement ->
+        assertTrue(statement.step(), "Expected a row for: $sql")
+        statement.block()
+    }
+}
