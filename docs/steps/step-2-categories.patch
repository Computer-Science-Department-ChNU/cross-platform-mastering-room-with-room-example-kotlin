+
+class FakeCategoryRepository(private val store: FakeStore = FakeStore()) : CategoryRepository {
+
+    override fun observeCategories(): Flow<List<Category>> =
+        combine(store.categories, store.tasks) { categories, tasks ->
+            categories.map { (id, name) -> Category(id, name, taskCount = tasks.count { it.categoryId == id }) }
+        }
+
+    override suspend fun addCategory(name: String) {
+        store.categories.update { it + (store.nextId++ to name) }
+    }
+
+    override suspend fun deleteCategory(id: Long) {
+        store.categories.update { list -> list.filterNot { it.first == id } }
+        store.tasks.update { list -> list.map { if (it.categoryId == id) it.copy(categoryId = null) else it } }
+    }
 }
