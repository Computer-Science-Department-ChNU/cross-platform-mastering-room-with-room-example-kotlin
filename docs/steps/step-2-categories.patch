+import ua.edu.chnu.kkn.masteringdb.data.local.entity.CategoryEntity
+import ua.edu.chnu.kkn.masteringdb.data.local.entity.TaskEntity
+
+class CategoryDaoTest {
+    private lateinit var db: AppDatabase
+
+    @BeforeTest
+    fun setUp() {
+        db = Room.inMemoryDatabaseBuilder<AppDatabase>()
+            .setDriver(BundledSQLiteDriver())
+            .build()
+    }
+
+    @AfterTest
+    fun tearDown() = db.close()
+
+    @Test
+    fun categoryWithTasks() = runTest {
+        val work = db.categoryDao().insert(CategoryEntity(name = "Work"))
+        db.taskDao().insert(TaskEntity(title = "Report", createdAt = 0, categoryId = work))
+        db.taskDao().insert(TaskEntity(title = "Meeting", createdAt = 1, categoryId = work))
+        db.taskDao().insert(TaskEntity(title = "No category", createdAt = 2))
+
+        val result = db.categoryDao().observeCategoryWithTasks(work).first()
+        assertEquals("Work", result?.category?.name)
+        assertEquals(setOf("Report", "Meeting"), result?.tasks?.map { it.title }?.toSet())
+    }
+
+    @Test
+    fun deletingCategorySetsTaskCategoryToNull() = runTest {
+        val home = db.categoryDao().insert(CategoryEntity(name = "Home"))
+        val taskId = db.taskDao().insert(TaskEntity(title = "Clean", createdAt = 0, categoryId = home))
+
+        db.categoryDao().deleteById(home)
+
+        assertNull(db.taskDao().getById(taskId)?.categoryId)
+    }
+
+    @Test
+    fun duplicateCategoryNameIsIgnored() = runTest {
+        db.categoryDao().insert(CategoryEntity(name = "Home"))
+        assertEquals(-1, db.categoryDao().insert(CategoryEntity(name = "Home")))
+    }
+}
