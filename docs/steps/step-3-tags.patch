+package ua.edu.chnu.kkn.masteringdb.data.local
+
+import androidx.room3.Room
+import androidx.sqlite.driver.bundled.BundledSQLiteDriver
+import kotlin.test.AfterTest
+import kotlin.test.BeforeTest
+import kotlin.test.Test
+import kotlin.test.assertEquals
+import kotlinx.coroutines.flow.first
+import kotlinx.coroutines.test.runTest
+import ua.edu.chnu.kkn.masteringdb.data.local.entity.TagEntity
+import ua.edu.chnu.kkn.masteringdb.data.local.entity.TaskEntity
+
+class TagDaoTest {
+    private lateinit var db: AppDatabase
+
+    @BeforeTest
+    fun setUp() {
+        db = Room.inMemoryDatabaseBuilder<AppDatabase>()
+            .setDriver(BundledSQLiteDriver())
+            .build()
+    }
+
+    @AfterTest
+    fun tearDown() = db.close()
+
+    @Test
+    fun taskWithTags() = runTest {
+        val urgent = db.tagDao().insert(TagEntity(name = "urgent"))
+        val home = db.tagDao().insert(TagEntity(name = "home"))
+        val taskId = db.taskDao().insertWithTags(TaskEntity(title = "Fix tap", createdAt = 0), setOf(urgent, home))
+
+        val details = db.taskDao().observeTaskWithTags(taskId).first()
+        assertEquals(setOf("urgent", "home"), details?.tags?.map { it.name }?.toSet())
+    }
+
+    @Test
+    fun tasksByTag() = runTest {
+        val urgent = db.tagDao().insert(TagEntity(name = "urgent"))
+        val dao = db.taskDao()
+        val first = dao.insertWithTags(TaskEntity(title = "First", createdAt = 1), setOf(urgent))
+        dao.insertWithTags(TaskEntity(title = "Second", createdAt = 2), setOf(urgent))
+        dao.insertWithTags(TaskEntity(title = "Untagged", createdAt = 3), emptySet())
+        dao.setDone(first, true)
+
+        assertEquals(listOf("Second", "First"), dao.observeByTag(urgent, done = null).first().map { it.task.title })
+        assertEquals(listOf("First"), dao.observeByTag(urgent, done = true).first().map { it.task.title })
+    }
+
+    @Test
+    fun setTagsReplacesLinksAndDeletingTagCascades() = runTest {
+        val a = db.tagDao().insert(TagEntity(name = "a"))
+        val b = db.tagDao().insert(TagEntity(name = "b"))
+        val taskId = db.taskDao().insertWithTags(TaskEntity(title = "Task", createdAt = 0), setOf(a))
+
+        db.taskDao().setTags(taskId, setOf(b))
+        assertEquals(listOf("b"), db.taskDao().observeTaskWithTags(taskId).first()?.tags?.map { it.name })
+
+        db.tagDao().deleteById(b)
+        assertEquals(emptyList(), db.taskDao().observeTaskWithTags(taskId).first()?.tags)
+    }
+}
