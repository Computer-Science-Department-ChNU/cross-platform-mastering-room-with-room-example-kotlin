+import ua.edu.chnu.kkn.masteringdb.data.model.Tag
+
+class RoomTagRepository(
+    private val tagDao: TagDao,
+) : TagRepository {
+
+    override fun observeTags(): Flow<List<Tag>> =
+        tagDao.observeAll().map { list -> list.map(TagEntity::toModel) }
+
+    override suspend fun getOrCreateTag(name: String): Long {
+        val id = tagDao.insert(TagEntity(name = name))
+        return if (id != -1L) id else requireNotNull(tagDao.getByName(name)).id
+    }
+
+    // Links to tasks are removed by ON DELETE CASCADE in task_tags
+    override suspend fun deleteTag(id: Long) {
+        tagDao.deleteById(id)
+    }
+}
