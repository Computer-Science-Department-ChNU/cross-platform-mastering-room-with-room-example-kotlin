+
+    @Test
+    fun migrate3To4_renamesColumnsAndKeepsRelations() = runTest {
+        helper.createDatabase(3).apply {
+            execSQL("INSERT INTO categories (id, name) VALUES (1, 'Home')")
+            execSQL("INSERT INTO tasks (id, title, description, is_done, created_at, category_id) VALUES (1, 'Clean', 'Kitchen', 1, 100, 1)")
+            execSQL("INSERT INTO tags (id, name) VALUES (1, 'weekly')")
+            execSQL("INSERT INTO task_tags (task_id, tag_id) VALUES (1, 1)")
+            close()
+        }
+
+        val connection = helper.runMigrationsAndValidate(4)
+
+        connection.querySingleRow("SELECT name, notes, is_done, created_at, category_id FROM tasks WHERE id = 1") {
+            assertEquals("Clean", getText(0))
+            assertEquals("Kitchen", getText(1))
+            assertEquals(1, getLong(2))
+            assertEquals(100, getLong(3))
+            assertEquals(1, getLong(4))
+        }
+        // The table is recreated during the migration - the links in task_tags must survive
+        connection.querySingleRow("SELECT COUNT(*) FROM task_tags WHERE task_id = 1") { assertEquals(1, getLong(0)) }
+        connection.close()
+    }
 }
 
