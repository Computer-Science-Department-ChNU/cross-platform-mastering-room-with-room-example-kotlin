+package ua.edu.chnu.kkn.masteringdb.data.local
+
+import androidx.room3.RenameColumn
+import androidx.room3.migration.AutoMigrationSpec
+
+/**
+ * 3 -> 4: a rename looks like "drop column + add column" to Room, so it needs a hint.
+ * Room generates the SQL (recreating the table and copying the data) from this spec.
+ */
+@RenameColumn(tableName = "tasks", fromColumnName = "title", toColumnName = "name")
+@RenameColumn(tableName = "tasks", fromColumnName = "description", toColumnName = "notes")
+class Migration3To4 : AutoMigrationSpec
