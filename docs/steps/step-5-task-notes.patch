 @RenameColumn(tableName = "tasks", fromColumnName = "title", toColumnName = "name")
 @RenameColumn(tableName = "tasks", fromColumnName = "description", toColumnName = "notes")
 class Migration3To4 : AutoMigrationSpec
+
+/**
+ * 4 -> 5: move `tasks.notes` into the one-to-one table `task_notes`.
+ * Room cannot know that the data has to be copied, so this migration is written by hand.
+ * The SQL is copied from schemas/.../5.json and must not reuse constants from the app code.
+ */
+val MIGRATION_4_5 = object : Migration(4, 5) {
+    override suspend fun migrate(connection: SQLiteConnection) {
+        connection.execSQL(
+            "CREATE TABLE IF NOT EXISTS `task_notes` (`task_id` INTEGER NOT NULL, `content` TEXT NOT NULL, " +
+                "PRIMARY KEY(`task_id`), FOREIGN KEY(`task_id`) REFERENCES `tasks`(`id`) " +
+                "ON UPDATE NO ACTION ON DELETE CASCADE )"
+        )
+        connection.execSQL(
+            "INSERT INTO `task_notes` (`task_id`, `content`) " +
+                "SELECT `id`, `notes` FROM `tasks` WHERE `notes` IS NOT NULL"
+        )
+        // SQLite 3.35+ (always true with BundledSQLiteDriver) can drop a plain column in place.
+        // Recreating `tasks` instead would also work, but is more SQL to get exactly right.
+        connection.execSQL("ALTER TABLE `tasks` DROP COLUMN `notes`")
+    }
+}
